
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IA na Prática</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    font-family: Arial, sans-serif;
}

body {
    background: #080d0b;
    color: white;
}

header {
    background: #101b15;
    padding: 22px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 15px;
    border-bottom: 1px solid #1b3828;
}

.logo {
    color: #38e878;
    font-size: 26px;
    font-weight: bold;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 20px;
    font-weight: bold;
}

nav a:hover {
    color: #38e878;
}

.hero {
    text-align: center;
    padding: 100px 20px;
    background: radial-gradient(circle, #123d25, #080d0b 70%);
}

.hero h1 {
    font-size: 48px;
    margin-bottom: 20px;
}

.hero h1 span {
    color: #38e878;
}

.hero p {
    color: #b8c9bd;
    font-size: 18px;
    margin-bottom: 30px;
}

.botao {
    display: inline-block;
    background: #38e878;
    color: #06140b;
    padding: 14px 25px;
    border-radius: 8px;
    text-decoration: none;
    font-weight: bold;
    border: none;
    cursor: pointer;
}

section {
    padding: 65px 8%;
}

.titulo {
    text-align: center;
    font-size: 32px;
    margin-bottom: 35px;
}

.titulo span {
    color: #38e878;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
}

.card {
    background: #111d16;
    padding: 28px;
    border: 1px solid #244632;
    border-radius: 12px;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-5px);
    border-color: #38e878;
}

.card h3 {
    color: #38e878;
    margin-bottom: 15px;
}

.card p {
    color: #bdc9c0;
    line-height: 1.6;
}

.quiz {
    max-width: 700px;
    margin: auto;
    background: #111d16;
    border: 1px solid #244632;
    border-radius: 12px;
    padding: 30px;
}

.quiz h3 {
    margin-bottom: 20px;
}

.opcao {
    display: block;
    width: 100%;
    background: #1a2b20;
    color: white;
    border: 1px solid #31543b;
    padding: 14px;
    border-radius: 8px;
    margin: 10px 0;
    text-align: left;
    cursor: pointer;
}

.opcao:hover {
    background: #245334;
}

#resultado {
    margin-top: 20px;
    color: #38e878;
    font-weight: bold;
}

.editor {
    max-width: 850px;
    margin: auto;
}

textarea {
    width: 100%;
    min-height: 180px;
    background: #050907;
    color: #38e878;
    border: 1px solid #31543b;
    padding: 18px;
    border-radius: 8px;
    font-family: monospace;
    font-size: 15px;
    resize: vertical;
}

.editor button {
    margin-top: 15px;
}

footer {
    text-align: center;
    padding: 30px;
    background: #101b15;
    color: #9caf9f;
    border-top: 1px solid #244632;
}

@media(max-width:600px) {
    .hero h1 {
        font-size: 34px;
    }

    nav a {
        margin-left: 8px;
        font-size: 13px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">IA NA PRÁTICA</div>

    <nav>
        <a href="#inicio">Início</a>
        <a href="#projetos">Projetos</a>
        <a href="#quiz">Quiz</a>
        <a href="#equipe">Equipe</a>
    </nav>
</header>

<main>

<section class="hero" id="inicio">
    <h1>O FUTURO É <span>AGORA</span></h1>
    <p>Aprenda, experimente e descubra o mundo da Inteligência Artificial.</p>
    <a href="#projetos" class="botao">Explorar projetos</a>
</section>

<section id="sobre">
    <h2 class="titulo">Sobre a <span>Eletiva</span></h2>

    <div class="cards">
        <article class="card">
            <h3>O que é IA?</h3>
            <p>Conheça a inteligência artificial e descubra como ela está transformando o mundo.</p>
        </article>

        <article class="card">
            <h3>Aprendizado</h3>
            <p>Aprenda conceitos, ferramentas e aplicações da inteligência artificial.</p>
        </article>

        <article class="card">
            <h3>Na prática</h3>
            <p>Desenvolva experiências, atividades e projetos tecnológicos.</p>
        </article>
    </div>
</section>

<section id="projetos">
    <h2 class="titulo">Nossos <span>Projetos</span></h2>

    <div class="cards">
        <article class="card">
            <h3>Programação</h3>
            <p>Experimente códigos e descubra como os programas funcionam.</p>
        </article>

        <article class="card">
            <h3>Inteligência Artificial</h3>
            <p>Explore ferramentas de IA e suas possibilidades.</p>
        </article>

        <article class="card">
            <h3>Desafios tecnológicos</h3>
            <p>Resolva problemas usando criatividade e raciocínio lógico.</p>
        </article>
    </div>
</section>

<section id="quiz">
    <h2 class="titulo">Quiz de <span>Tecnologia</span></h2>

    <div class="quiz">
        <h3 id="pergunta">1. O que significa IA?</h3>
        <div id="opcoes"></div>
        <p id="resultado"></p>
        <button class="botao" onclick="proximaPergunta()">Próxima pergunta</button>
    </div>
</section>

<section id="codigo">
    <h2 class="titulo">Laboratório de <span>Código</span></h2>

    <div class="editor">
        <p>Escreva seu código HTML abaixo:</p>
        <br>

        <textarea id="codigoUsuario" placeholder="Digite seu código HTML aqui..."></textarea>

        <button class="botao" onclick="executarCodigo()">Executar código</button>

        <h3 style="margin:25px 0 15px;">Resultado:</h3>

        <iframe id="resultadoCodigo"
            title="Resultado do código"
            sandbox="allow-scripts"
            style="width:100%;height:250px;background:white;border-radius:8px;border:0;">
        </iframe>
    </div>
</section>

<section id="equipe">
    <h2 class="titulo">Nossa <span>Equipe</span></h2>

    <div class="cards">
        <article class="card">
            <h3>David Luiz</h3>
            <p>Desenvolvimento e organização.</p>
        </article>

        <article class="card">
            <h3>Luis Miguel</h3>
            <p>Equipe de desenvolvimento.</p>
        </article>

        <article class="card">
            <h3>Rafael</h3>
            <p>Equipe de desenvolvimento.</p>
        </article>

        <article class="card">
            <h3>Gilberto</h3>
            <p>Equipe de desenvolvimento.</p>
        </article>
    </div>
</section>

</main>

<footer>
    <p>IA na Prática © 2026</p>
    <p>Professores: Carol e Letícia</p>
    <p>Aprender. Criar. Inovar.</p>
</footer>

<script>
const perguntas = [
    {
        pergunta: "1. O que significa IA?",
        opcoes: ["Internet Avançada", "Inteligência Artificial", "Informação Automática"],
        correta: 1
    },
    {
        pergunta: "2. Qual linguagem é usada para estruturar páginas web?",
        opcoes: ["HTML", "Python", "Java"],
        correta: 0
    },
    {
        pergunta: "3. Qual é uma aplicação da inteligência artificial?",
        opcoes: ["Calculadora comum", "Reconhecimento de imagens", "Lápis"],
        correta: 1
    },
    {
        pergunta: "4. O que é um algoritmo?",
        opcoes: ["Uma sequência de instruções", "Um computador", "Uma rede social"],
        correta: 0
    },
    {
        pergunta: "5. Qual linguagem é usada para criar interatividade em páginas web?",
        opcoes: ["CSS", "JavaScript", "HTML"],
        correta: 1
    }
];

let atual = 0;
let pontuacao = 0;
let respondeu = false;

function carregarPergunta() {
    respondeu = false;

    const p = perguntas[atual];

    document.getElementById("pergunta").textContent = p.pergunta;
    document.getElementById("resultado").textContent = "";

    const opcoes = document.getElementById("opcoes");
    opcoes.innerHTML = "";

    p.opcoes.forEach((opcao, indice) => {
        const botao = document.createElement("button");
        botao.className = "opcao";
        botao.textContent = opcao;
        botao.onclick = () => responder(indice);
        opcoes.appendChild(botao);
    });
}

function responder(indice) {
    if (respondeu) return;

    respondeu = true;

    if (indice === perguntas[atual].correta) {
        pontuacao++;
        document.getElementById("resultado").textContent = "Resposta correta!";
    } else {
        document.getElementById("resultado").textContent =
            "Resposta incorreta! Correta: " +
            perguntas[atual].opcoes[perguntas[atual].correta];
    }
}

function proximaPergunta() {
    if (!respondeu) {
        document.getElementById("resultado").textContent =
            "Responda antes de continuar!";
        return;
    }

    atual++;

    if (atual >= perguntas.length) {
        document.getElementById("pergunta").textContent =
            "Quiz finalizado!";

        document.getElementById("opcoes").innerHTML = "";

        document.getElementById("resultado").textContent =
            "Você acertou " + pontuacao + " de " + perguntas.length + " perguntas!";

        return;
    }

    carregarPergunta();
}

function executarCodigo() {
    const codigo = document.getElementById("codigoUsuario").value;

    document.getElementById("resultadoCodigo").srcdoc = codigo;
}

carregarPergunta();
</script>

</body>
</html>
