
<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IA na Prática | Aprenda Inteligência Artificial</title>
<meta name="description" content="Uma plataforma educacional para aprender, explorar e utilizar inteligência artificial.">

<style>
:root {
  --bg: #07111f;
  --panel: #101e31;
  --panel2: #14263d;
  --blue: #3185ff;
  --cyan: #36d5ed;
  --text: #f4f7fc;
  --muted: #9aabc2;
  --border: rgba(255,255,255,.09);
}

* { margin:0; padding:0; box-sizing:border-box; }

html { scroll-behavior:smooth; }

body {
  background:var(--bg);
  color:var(--text);
  font-family:Arial, sans-serif;
  line-height:1.6;
}

button, input, textarea, select { font:inherit; }

header {
  position:sticky;
  top:0;
  z-index:100;
  background:rgba(7,17,31,.94);
  backdrop-filter:blur(15px);
  border-bottom:1px solid var(--border);
}

.nav {
  max-width:1200px;
  margin:auto;
  padding:18px 24px;
  display:flex;
  justify-content:space-between;
  align-items:center;
  gap:20px;
}

.logo {
  font-size:21px;
  font-weight:900;
  letter-spacing:-1px;
}

.logo span { color:var(--cyan); }

nav { display:flex; gap:20px; flex-wrap:wrap; }

nav a {
  color:var(--muted);
  text-decoration:none;
  font-size:13px;
}

nav a:hover { color:var(--cyan); }

.hero {
  max-width:1200px;
  margin:auto;
  padding:95px 24px 75px;
  display:grid;
  grid-template-columns:1.3fr .7fr;
  align-items:center;
  gap:45px;
}

.tag {
  display:inline-block;
  color:var(--cyan);
  background:rgba(54,213,237,.1);
  border:1px solid rgba(54,213,237,.2);
  padding:7px 13px;
  border-radius:30px;
  font-size:12px;
  margin-bottom:20px;
}

h1 {
  font-size:clamp(40px,6vw,68px);
  line-height:1.08;
  letter-spacing:-3px;
}

.gradient {
  background:linear-gradient(90deg,var(--blue),var(--cyan));
  -webkit-background-clip:text;
  color:transparent;
}

.hero p {
  color:var(--muted);
  max-width:580px;
  margin:22px 0;
}

.btn {
  display:inline-block;
  padding:13px 21px;
  border:0;
  border-radius:9px;
  background:var(--blue);
  color:white;
  font-weight:bold;
  cursor:pointer;
  text-decoration:none;
  transition:.2s;
}

.btn:hover { transform:translateY(-2px); filter:brightness(1.15); }

.btn.secondary {
  background:var(--panel2);
  border:1px solid var(--border);
}

.hero-card {
  background:linear-gradient(145deg,#142b48,#0d192b);
  border:1px solid var(--border);
  border-radius:20px;
  padding:30px;
  box-shadow:0 20px 70px #0005;
}

.hero-card h3 { margin-bottom:15px; }

.hero-card p {
  padding:12px;
  margin:9px 0;
  border-radius:8px;
  background:rgba(255,255,255,.04);
  font-size:13px;
}

section {
  max-width:1200px;
  margin:auto;
  padding:65px 24px;
}

.section-title {
  font-size:34px;
  letter-spacing:-1px;
  margin-bottom:10px;
}

.section-desc {
  color:var(--muted);
  margin-bottom:30px;
}

.grid {
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:18px;
}

.card {
  background:var(--panel);
  border:1px solid var(--border);
  border-radius:15px;
  padding:23px;
  transition:.25s;
}

.card:hover {
  transform:translateY(-5px);
  border-color:var(--blue);
}

.card .symbol {
  font-size:28px;
  margin-bottom:12px;
}

.card h3 { margin-bottom:8px; }

.card p {
  color:var(--muted);
  font-size:14px;
}

.tool {
  background:var(--panel);
  border:1px solid var(--border);
  padding:25px;
  border-radius:15px;
  margin-top:20px;
}

label {
  display:block;
  margin:13px 0 6px;
  font-size:13px;
  color:#c9d7e9;
}

input, textarea, select {
  width:100%;
  padding:13px;
  background:#081525;
  color:white;
  border:1px solid var(--border);
  border-radius:8px;
  outline:none;
}

input:focus, textarea:focus, select:focus {
  border-color:var(--blue);
}

textarea { resize:vertical; min-height:100px; }

.result {
  background:#081525;
  border:1px solid var(--border);
  border-radius:9px;
  padding:16px;
  margin-top:15px;
  white-space:pre-wrap;
  overflow-wrap:anywhere;
  color:#dcecff;
  min-height:50px;
}

.hidden { display:none; }

.quiz-option {
  display:block;
  width:100%;
  padding:13px;
  margin:9px 0;
  border:1px solid var(--border);
  background:var(--panel2);
  color:white;
  border-radius:8px;
  cursor:pointer;
  text-align:left;
}

.quiz-option:hover { border-color:var(--cyan); }

footer {
  border-top:1px solid var(--border);
  padding:35px 20px;
  text-align:center;
  color:var(--muted);
  font-size:13px;
}

.small {
  color:var(--muted);
  font-size:12px;
}

@media(max-width:800px) {
  .hero { grid-template-columns:1fr; padding-top:60px; }
  .grid { grid-template-columns:1fr 1fr; }
  nav { gap:10px; }
}

@media(max-width:550px) {
  .grid { grid-template-columns:1fr; }
  .nav { align-items:flex-start; flex-direction:column; }
  h1 { letter-spacing:-2px; }
}
</style>
</head>

<body>

<header>
  <div class="nav">
    <div class="logo">IA NA <span>PRÁTICA.</span></div>
    <nav>
      <a href="#inicio">Início</a>
      <a href="#ferramentas">Ferramentas</a>
      <a href="#laboratorio">Laboratório</a>
      <a href="#quiz">Quiz</a>
      <a href="#sobre">Sobre</a>
    </nav>
  </div>
</header>

<main>

<section class="hero" id="inicio">
  <div>
    <span class="tag">TECNOLOGIA • EDUCAÇÃO • INOVAÇÃO</span>
    <h1>O futuro começa com <span class="gradient">conhecimento.</span></h1>
    <p>
      Descubra o universo da inteligência artificial.
      Aprenda conceitos, desenvolva habilidades e experimente
      ferramentas tecnológicas em um só lugar.
    </p>
    <a href="#ferramentas" class="btn">Explorar plataforma</a>
    <a href="#laboratorio" class="btn secondary">Ir ao laboratório</a>
  </div>

  <div class="hero-card">
    <span class="tag">CENTRO DE APRENDIZAGEM</span>
    <h3>Explore novas possibilidades.</h3>
    <p>01. Aprenda sobre inteligência artificial</p>
    <p>02. Desenvolva seus próprios prompts</p>
    <p>03. Teste seus conhecimentos</p>
    <p>04. Descubra novas tecnologias</p>
  </div>
</section>

<section id="ferramentas">
  <h2 class="section-title">Explore a plataforma</h2>
  <p class="section-desc">Recursos educacionais para aprender fazendo.</p>

  <div class="grid">
    <div class="card">
      <div class="symbol">🧠</div>
      <h3>Aprenda IA</h3>
      <p>Entenda os fundamentos e as aplicações da inteligência artificial.</p>
    </div>

    <div class="card">
      <div class="symbol">✍️</div>
      <h3>Criador de prompts</h3>
      <p>Aprenda a estruturar comandos mais claros e eficientes.</p>
    </div>

    <div class="card">
      <div class="symbol">📚</div>
      <h3>Biblioteca</h3>
      <p>Conheça exemplos de prompts para diferentes atividades.</p>
    </div>

    <div class="card">
      <div class="symbol">🎯</div>
      <h3>Desafios</h3>
      <p>Coloque seus conhecimentos em prática.</p>
    </div>

    <div class="card">
      <div class="symbol">💡</div>
      <h3>Curiosidades</h3>
      <p>Descubra fatos interessantes sobre o desenvolvimento da IA.</p>
    </div>

    <div class="card">
      <div class="symbol">🔎</div>
      <h3>Dicionário de IA</h3>
      <p>Conheça os principais termos do universo tecnológico.</p>
    </div>
  </div>
</section>

<section id="laboratorio">
  <h2 class="section-title">Laboratório de prompts</h2>
  <p class="section-desc">Monte seu próprio comando e copie o resultado.</p>

  <div class="tool">
    <h3>Criador inteligente de prompts</h3>

    <label>Qual é o objetivo?</label>
    <input id="objetivo" placeholder="Ex: Criar um plano de estudos">

    <label>Qual é o contexto?</label>
    <textarea id="contexto" placeholder="Explique o que a IA precisa saber..."></textarea>

    <label>Como deve ser a resposta?</label>
    <select id="formato">
      <option>Explicação detalhada</option>
      <option>Lista organizada</option>
      <option>Passo a passo</option>
      <option>Resumo</option>
      <option>Tabela</option>
    </select>

    <button class="btn" onclick="criarPrompt()">Gerar meu prompt</button>

    <div id="resultadoPrompt" class="result hidden"></div>
    <button class="btn secondary hidden" id="copiarPrompt" onclick="copiar('resultadoPrompt')">Copiar prompt</button>
  </div>
</section>

<section id="biblioteca">
  <h2 class="section-title">Biblioteca de prompts</h2>
  <p class="section-desc">Exemplos para estudar, criar e desenvolver ideias.</p>

  <div class="grid">
    <div class="card">
      <h3>📖 Estudos</h3>
      <p>Explique um assunto como um professor, utilizando exemplos simples e exercícios.</p>
      <button class="btn secondary" onclick="usarPrompt('Explique um assunto como um professor, utilizando exemplos simples e exercícios.')">Usar exemplo</button>
    </div>

    <div class="card">
      <h3>💻 Programação</h3>
      <p>Ensine programação passo a passo, explicando o funcionamento de cada parte do código.</p>
      <button class="btn secondary" onclick="usarPrompt('Ensine programação passo a passo, explicando o funcionamento de cada parte do código.')">Usar exemplo</button>
    </div>

    <div class="card">
      <h3>🌎 Criatividade</h3>
      <p>Apresente cinco ideias inovadoras para resolver um problema da comunidade escolar.</p>
      <button class="btn secondary" onclick="usarPrompt('Apresente cinco ideias inovadoras para resolver um problema da comunidade escolar.')">Usar exemplo</button>
    </div>
  </div>
</section>

<section id="quiz">
  <h2 class="section-title">Teste seus conhecimentos</h2>
  <p class="section-desc">Descubra quanto você sabe sobre inteligência artificial.</p>

  <div class="tool">
    <h3 id="pergunta">Carregando pergunta...</h3>
    <div id="opcoes"></div>
    <p id="feedback"></p>
    <p id="pontuacao" class="small">Pontuação: 0</p>
    <button class="btn hidden" id="proxima" onclick="proximaPergunta()">Próxima pergunta</button>
    <button class="btn secondary hidden" id="reiniciar" onclick="reiniciarQuiz()">Recomeçar</button>
  </div>
</section>

<section id="dicionario">
  <h2 class="section-title">Dicionário tecnológico</h2>
  <p class="section-desc">Pesquise conceitos importantes da inteligência artificial.</p>

  <div class="tool">
    <input id="busca" placeholder="Digite um termo..." oninput="buscarTermo()">
    <div id="definicao" class="result">Digite uma palavra para começar.</div>
  </div>
</section>

<section id="curiosidades">
  <h2 class="section-title">Você sabia?</h2>
  <div class="tool">
    <h3 id="curiosidade">A inteligência artificial possui diferentes áreas de pesquisa.</h3>
    <button class="btn" onclick="novaCuriosidade()">Outra curiosidade</button>
  </div>
</section>

<section id="sobre">
  <h2 class="section-title">Sobre o projeto</h2>
  <div class="tool">
    <h3>Conhecimento que transforma.</h3>
    <p style="color:var(--muted);margin-top:12px">
      O IA na Prática é um projeto educacional desenvolvido
      para aproximar estudantes do universo da inteligência
      artificial e da tecnologia.
    </p>
    <p style="color:var(--muted);margin-top:12px">
      Nosso objetivo é incentivar a curiosidade, a criatividade,
      o pensamento crítico e o aprendizado tecnológico.
    </p>
    <p style="margin-top:18px;color:var(--cyan)">
      Desenvolvido por um estudante, para a comunidade escolar.
    </p>
  </div>
</section>

</main>

<footer>
  <div class="logo">IA NA <span>PRÁTICA.</span></div>
  <p>Educação, tecnologia e inovação.</p>
  <p>© 2026 IA na Prática. Projeto educacional.</p>
</footer>

<script>

// CRIADOR DE PROMPTS

function criarPrompt() {
  const objetivo = document.getElementById("objetivo").value.trim();
  const contexto = document.getElementById("contexto").value.trim();
  const formato = document.getElementById("formato").value;

  if (!objetivo) {
    alert("Digite o objetivo do seu prompt!");
    return;
  }

  const texto =
`Atue como um especialista no assunto.

OBJETIVO:
${objetivo}

CONTEXTO:
${contexto || "Utilize informações relevantes para compreender o objetivo."}

FORMATO DA RESPOSTA:
${formato}

INSTRUÇÕES:
- Seja claro e organizado.
- Explique os conceitos importantes.
- Utilize exemplos quando necessário.
- Não invente informações.
- Avise quando houver incerteza.`;

  document.getElementById("resultadoPrompt").textContent = texto;
  document.getElementById("resultadoPrompt").classList.remove("hidden");
  document.getElementById("copiarPrompt").classList.remove("hidden");
}

function usarPrompt(texto) {
  document.getElementById("objetivo").value = texto;
  document.getElementById("contexto").value = "Quero uma resposta adequada para um estudante.";
  document.getElementById("laboratorio").scrollIntoView();
}

// COPIAR TEXTO

function copiar(id) {
  const texto = document.getElementById(id).textContent;
  navigator.clipboard.writeText(texto)
    .then(() => alert("Texto copiado!"))
    .catch(() => alert("Não foi possível copiar. Selecione o texto manualmente."));
}

// QUIZ

const perguntas = [
  {
    pergunta:"O que significa IA?",
    opcoes:["Internet Avançada","Inteligência Artificial","Informação Automática"],
    correta:1
  },
  {
    pergunta:"Qual é uma aplicação da inteligência artificial?",
    opcoes:["Reconhecimento de imagens","Uma cadeira comum","Uma folha de papel"],
    correta:0
  },
  {
    pergunta:"O que é um prompt?",
    opcoes:["Um computador","Uma instrução enviada à IA","Um sistema operacional"],
    correta:1
  },
  {
    pergunta:"A IA pode cometer erros?",
    opcoes:["Não, nunca","Sim, pode gerar informações incorretas","Somente aos domingos"],
    correta:1
  },
  {
    pergunta:"O que é aprendizado de máquina?",
    opcoes:["Uma área da IA que aprende padrões a partir de dados","Um tipo de teclado","Um navegador"],
    correta:0
  }
];

let atual = 0;
let pontos = 0;
let respondido = false;

function carregarPergunta() {
  respondido = false;
  const p = perguntas[atual];

  document.getElementById("pergunta").textContent =
    `Pergunta ${atual+1}/${perguntas.length}: ${p.pergunta}`;

  document.getElementById("feedback").textContent = "";
  document.getElementById("proxima").classList.add("hidden");

  const opcoes = document.getElementById("opcoes");
  opcoes.innerHTML = "";

  p.opcoes.forEach((opcao,index) => {
    const botao = document.createElement("button");
    botao.className = "quiz-option";
    botao.textContent = opcao;
    botao.onclick = () => responder(index);
    opcoes.appendChild(botao);
  });
}

function responder(indice) {
  if (respondido) return;
  respondido = true;

  const correta = perguntas[atual].correta;
  const botoes = document.querySelectorAll(".quiz-option");

  botoes.forEach((botao,index) => {
    botao.disabled = true;
    if (index === correta) botao.style.borderColor = "#36d5ed";
  });

  if (indice === correta) {
    pontos++;
    document.getElementById("feedback").textContent = "Resposta correta! Muito bem.";
  } else {
    document.getElementById("feedback").textContent =
      "Não foi dessa vez. A resposta correta é: " +
      perguntas[atual].opcoes[correta];
  }

  document.getElementById("pontuacao").textContent =
    `Pontuação: ${pontos}/${perguntas.length}`;

  if (atual < perguntas.length-1) {
    document.getElementById("proxima").classList.remove("hidden");
  } else {
    document.getElementById("feedback").textContent +=
      ` Resultado final: ${pontos} de ${perguntas.length} pontos!`;
    document.getElementById("reiniciar").classList.remove("hidden");
  }
}

function proximaPergunta() {
  atual++;
  carregarPergunta();
}

function reiniciarQuiz() {
  atual = 0;
  pontos = 0;
  document.getElementById("pontuacao").textContent = "Pontuação: 0";
  document.getElementById("reiniciar").classList.add("hidden");
  carregarPergunta();
}

carregarPergunta();

// DICIONÁRIO

const termos = {
  "inteligência artificial":"Tecnologia que permite a sistemas computacionais executar tarefas associadas a capacidades humanas, como reconhecer padrões e gerar conteúdo.",
  "machine learning":"Aprendizado de máquina. Área da IA que utiliza dados para identificar padrões e fazer previsões.",
  "prompt":"Instrução ou conjunto de instruções fornecidas a uma ferramenta de inteligência artificial.",
  "algoritmo":"Conjunto organizado de instruções para resolver um problema ou realizar uma tarefa.",
  "chatbot":"Programa que conversa com pessoas por meio de texto ou voz.",
  "rede neural":"Modelo computacional inspirado de forma simplificada nas conexões entre neurônios.",
  "deep learning":"Aprendizado profundo, uma área de aprendizado de máquina que utiliza redes neurais com várias camadas.",
  "dados":"Informações utilizadas para análise, treinamento e funcionamento de sistemas.",
  "automação":"Uso de tecnologia para executar tarefas com pouca ou nenhuma intervenção humana.",
  "ia generativa":"Tipo de inteligência artificial capaz de gerar conteúdos como textos, imagens, áudio e código."
};

function buscarTermo() {
  const busca = document.getElementById("busca").value
    .toLowerCase().trim();

  const definicao = document.getElementById("definicao");

  if (!busca) {
    definicao.textContent = "Digite uma palavra para começar.";
    return;
  }

  const termo = Object.keys(termos).find(t => t.includes(busca));

  definicao.textContent = termo
    ? termos[termo]
    : "Termo não encontrado. Experimente outra palavra.";
}

// CURIOSIDADES

const curiosidades = [
  "A inteligência artificial é estudada há décadas e seu campo de pesquisa começou a ganhar forma na década de 1950.",
  "Existem sistemas de IA capazes de reconhecer padrões em imagens.",
  "A IA generativa consegue produzir textos, imagens e outros tipos de conteúdo.",
  "Aprendizado de máquina é uma das principais áreas da inteligência artificial.",
  "A qualidade dos dados pode influenciar bastante os resultados de um sistema de IA.",
  "A inteligência artificial também é utilizada em pesquisas científicas.",
  "Nem toda automação utiliza inteligência artificial."
];

function novaCuriosidade() {
  const indice = Math.floor(Math.random()*curiosidades.length);
  document.getElementById("curiosidade").textContent = curiosidades[indice];
}

</script>

</body>
</html>
