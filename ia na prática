<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>IA na Prática</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    background: #071326;
    color: #fff;
}

header {
    background: #050d1b;
    padding: 22px 8%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 20px;
    border-bottom: 1px solid #c5a451;
}

.logo {
    font-size: 25px;
    font-weight: bold;
    color: #e5c36b;
}

nav {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
}

nav a {
    color: white;
    text-decoration: none;
    font-weight: bold;
}

nav a:hover {
    color: #e5c36b;
}

section {
    padding: 75px 8%;
}

.hero {
    min-height: 480px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: center;
    align-items: center;
    background: linear-gradient(135deg, #071326, #102b50, #071326);
}

.hero h1 {
    font-size: clamp(35px, 6vw, 60px);
    color: #e5c36b;
    margin-bottom: 20px;
}

.hero p {
    max-width: 700px;
    line-height: 1.7;
    color: #d0dcec;
    font-size: 18px;
}

.btn {
    display: inline-block;
    margin-top: 25px;
    padding: 15px 30px;
    background: #d8b45a;
    color: #071326;
    text-decoration: none;
    border-radius: 8px;
    font-weight: bold;
    border: none;
    cursor: pointer;
    transition: .3s;
}

.btn:hover {
    background: #f1d58d;
    transform: translateY(-3px);
}

.section-title {
    font-size: 34px;
    color: #e5c36b;
    margin-bottom: 15px;
    text-align: center;
}

.section-description {
    color: #c4d5ec;
    text-align: center;
    margin-bottom: 40px;
    line-height: 1.7;
}

.cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 22px;
}

.card {
    background: #10233e;
    padding: 28px;
    border: 1px solid #263f60;
    border-radius: 14px;
    transition: .3s;
}

.card:hover {
    transform: translateY(-6px);
    border-color: #d8b45a;
}

.card h3 {
    color: #e5c36b;
    margin-bottom: 15px;
}

.card p {
    color: #d0dcec;
    line-height: 1.7;
}

#aprendizado {
    background: #0a1930;
}

#jogos {
    background: #0a1930;
}

#projetos {
    background: #071326;
}

#quiz {
    background: linear-gradient(135deg, #071326, #102b50, #071326);
}

#quiz .section-title {
    color: #f1c96b;
}

#quiz .section-description {
    color: #c4d5ec;
}

.quiz-box {
    background: linear-gradient(145deg, #10233e, #09172b);
    max-width: 750px;
    margin: auto;
    padding: 35px;
    border-radius: 18px;
    border: 1px solid #d8b45a;
    box-shadow: 0 15px 45px rgba(0,0,0,.3);
}

.quiz-top {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 20px;
    color: #e5c36b;
    font-weight: bold;
}

.progress-container {
    width: 100%;
    height: 9px;
    background: #253b57;
    border-radius: 20px;
    margin-bottom: 30px;
    overflow: hidden;
}

#progress {
    height: 100%;
    width: 0%;
    background: #e5c36b;
    transition: .3s;
}

#question {
    font-size: 23px;
    margin-bottom: 25px;
    line-height: 1.5;
}

.answers {
    display: grid;
    gap: 13px;
}

.answer {
    padding: 16px;
    background: #162e4d;
    color: white;
    border: 1px solid #38516e;
    border-radius: 9px;
    text-align: left;
    font-size: 16px;
    cursor: pointer;
    transition: .2s;
}

.answer:hover:not(:disabled) {
    border-color: #e5c36b;
    background: #203e62;
}

.answer.correct {
    background: #155c3a;
    border-color: #39d98a;
}

.answer.wrong {
    background: #702b35;
    border-color: #ff6978;
}

.answer:disabled {
    cursor: default;
    opacity: .95;
}

#feedback {
    margin-top: 20px;
    font-weight: bold;
    min-height: 24px;
    line-height: 1.5;
}

#nextButton {
    display: none;
    width: 100%;
    margin-top: 25px;
    padding: 15px;
    background: #d8b45a;
    color: #071326;
    border: none;
    border-radius: 8px;
    font-size: 16px;
    font-weight: bold;
    cursor: pointer;
}

#nextButton:hover {
    background: #f1d58d;
}

#result {
    display: none;
    text-align: center;
}

#result h3 {
    font-size: 30px;
    color: #e5c36b;
    margin-bottom: 20px;
}

#score {
    font-size: 48px;
    color: #e5c36b;
    margin: 20px;
    font-weight: bold;
}

#result p {
    line-height: 1.7;
    color: #d0dcec;
}

#restartButton {
    margin-top: 25px;
}

footer {
    background: #050d1b;
    padding: 30px;
    text-align: center;
    color: #aebed1;
    border-top: 1px solid #263f60;
}

@media(max-width: 600px) {
    header {
        justify-content: center;
    }

    nav {
        justify-content: center;
        gap: 14px;
    }

    section {
        padding: 55px 6%;
    }

    .quiz-box {
        padding: 22px;
    }

    #question {
        font-size: 19px;
    }
}
</style>
</head>

<body>

<header>
    <div class="logo">IA NA PRÁTICA</div>

    <nav>
        <a href="#inicio">Início</a>
        <a href="#aprendizado">Aprendizado</a>
        <a href="#quiz">Quiz</a>
        <a href="#jogos">Jogos</a>
        <a href="#projetos">Projetos</a>
        <a href="#sobre">Sobre</a>
    </nav>
</header>

<section class="hero" id="inicio">
    <h1>IA na Prática</h1>

    <p>
        Descubra como a Inteligência Artificial está transformando
        o mundo. Aprenda, explore conhecimentos e desenvolva novas ideias
        utilizando a tecnologia.
    </p>

    <a href="#aprendizado" class="btn">Explorar plataforma</a>
</section>

<section id="aprendizado">
    <h2 class="section-title">Aprendizado</h2>

    <p class="section-description">
        Conheça conceitos importantes sobre Inteligência Artificial.
    </p>

    <div class="cards">

        <div class="card">
            <h3>O que é IA?</h3>
            <p>
                Inteligência Artificial é uma tecnologia que permite
                que computadores realizem tarefas que normalmente
                exigem capacidades humanas.
            </p>
        </div>

        <div class="card">
            <h3>Como funciona?</h3>
            <p>
                Sistemas de IA utilizam dados e algoritmos para
                identificar padrões e produzir resultados.
            </p>
        </div>

        <div class="card">
            <h3>IA no cotidiano</h3>
            <p>
                A inteligência artificial está presente em celulares,
                aplicativos, pesquisas e diversas ferramentas.
            </p>
        </div>

        <div class="card">
            <h3>O futuro da IA</h3>
            <p>
                A tecnologia continua evoluindo e criando novas
                possibilidades para a sociedade.
            </p>
        </div>

    </div>
</section>

<section id="quiz">
    <h2 class="section-title">Desafio do Conhecimento</h2>

    <p class="section-description">
        Teste seus conhecimentos sobre tecnologia, lógica e inteligência artificial.
    </p>

    <div class="quiz-box">

        <div id="quizContent">

            <div class="quiz-top">
                <span id="questionNumber">Questão 1</span>
                <span id="points">Pontos: 0</span>
            </div>

            <div class="progress-container">
                <div id="progress"></div>
            </div>

            <h3 id="question"></h3>

            <div class="answers" id="answers"></div>

            <div id="feedback"></div>

            <button id="nextButton" onclick="proxima()">
                Próxima questão
            </button>

        </div>

        <div id="result">

            <h3>Desafio concluído!</h3>

            <p>Sua pontuação final foi:</p>

            <div id="score">0/12</div>

            <p id="resultMessage"></p>

            <button class="btn" id="restartButton" onclick="reiniciar()">
                Jogar novamente
            </button>

        </div>

    </div>
</section>

<section id="jogos">
    <h2 class="section-title">Jogos Educativos</h2>

    <p class="section-description">
        Exercite seu raciocínio e coloque seus conhecimentos à prova.
    </p>

    <div class="cards">

        <div class="card">
            <h3>Desafio de Lógica</h3>
            <p>
                Descubra padrões, resolva problemas e desenvolva
                seu pensamento lógico.
            </p>
            <button class="btn" onclick="jogoLogica()">
                Jogar
            </button>
        </div>

        <div class="card">
            <h3>Desafio Matemático</h3>
            <p>
                Resolva cálculos e teste suas habilidades
                matemáticas.
            </p>
            <button class="btn" onclick="jogoMatematica()">
                Jogar
            </button>
        </div>

        <div class="card">
            <h3>Desafio Tecnológico</h3>
            <p>
                Responda perguntas sobre tecnologia e descubra
                novos conhecimentos.
            </p>
            <button class="btn" onclick="jogoTecnologia()">
                Jogar
            </button>
        </div>

    </div>
</section>

<section id="projetos">
    <h2 class="section-title">Projetos</h2>

    <p class="section-description">
        Um espaço para apresentar ideias, criatividade e
        conhecimentos desenvolvidos durante a eletiva.
    </p>

    <div class="cards">

        <div class="card">
            <h3>Ideias Tecnológicas</h3>
            <p>
                Projetos que exploram possibilidades da inteligência
                artificial e da tecnologia.
            </p>
        </div>

        <div class="card">
            <h3>Criatividade</h3>
            <p>
                Soluções criativas para desafios do cotidiano
                utilizando ferramentas digitais.
            </p>
        </div>

        <div class="card">
            <h3>Conhecimento</h3>
            <p>
                Aprendizados e descobertas desenvolvidos pelos
                participantes da eletiva.
            </p>
        </div>

    </div>
</section>

<section id="sobre">
    <h2 class="section-title">Sobre o projeto</h2>

    <p class="section-description">
        O IA na Prática é um projeto educacional que busca aproximar
        os estudantes do universo da Inteligência Artificial,
        incentivando a curiosidade, a criatividade e o aprendizado
        por meio da tecnologia.
    </p>
</section>

<footer>
    <p>IA na Prática © 2026</p>
    <p>Educação, criatividade e tecnologia.</p>
</footer>

<script>

const perguntas = [

    {
        pergunta: "O que significa a sigla IA?",
        opcoes: [
            "Internet Automática",
            "Inteligência Artificial",
            "Informação Avançada",
            "Interface Automática"
        ],
        correta: 1,
        explicacao: "IA significa Inteligência Artificial."
    },

    {
        pergunta: "Qual é uma das principais funções da Inteligência Artificial?",
        opcoes: [
            "Apenas armazenar arquivos",
            "Substituir a internet",
            "Identificar padrões e auxiliar em tarefas",
            "Desligar computadores"
        ],
        correta: 2,
        explicacao: "A IA pode identificar padrões e auxiliar em diversas tarefas."
    },

    {
        pergunta: "Qual destas ferramentas utiliza Inteligência Artificial?",
        opcoes: [
            "ChatGPT",
            "Calculadora simples",
            "Bloco de notas",
            "Relógio analógico"
        ],
        correta: 0,
        explicacao: "O ChatGPT utiliza modelos de Inteligência Artificial."
    },

    {
        pergunta: "O que são algoritmos?",
        opcoes: [
            "Peças de computador",
            "Sequências de instruções para resolver problemas",
            "Tipos de internet",
            "Programas de desenho"
        ],
        correta: 1,
        explicacao: "Algoritmos são sequências organizadas de instruções."
    },

    {
        pergunta: "Qual linguagem é muito utilizada no desenvolvimento de sites?",
        opcoes: [
            "HTML",
            "Português",
            "PDF",
            "Windows"
        ],
        correta: 0,
        explicacao: "HTML é utilizado para estruturar páginas da internet."
    },

    {
        pergunta: "O que é Machine Learning?",
        opcoes: [
            "Um tipo de teclado",
            "Uma rede social",
            "Aprendizado de máquina",
            "Um sistema operacional"
        ],
        correta: 2,
        explicacao: "Machine Learning é uma área da IA que permite aprender padrões a partir de dados."
    },

    {
        pergunta: "A Inteligência Artificial pode cometer erros?",
        opcoes: [
            "Não, nunca",
            "Sim, pode produzir informações incorretas",
            "Somente à noite",
            "Apenas sem internet"
        ],
        correta: 1,
        explicacao: "Sistemas de IA podem cometer erros e precisam ser verificados."
    },

    {
        pergunta: "Qual destes é um exemplo de uso da IA?",
        opcoes: [
            "Reconhecimento de voz",
            "Lápis comum",
            "Caderno de papel",
            "Borracha escolar"
        ],
        correta: 0,
        explicacao: "O reconhecimento de voz pode utilizar Inteligência Artificial."
    },

    {
        pergunta: "O que é um prompt?",
        opcoes: [
            "Um tipo de computador",
            "Uma instrução enviada para uma IA",
            "Um antivírus",
            "Uma peça eletrônica"
        ],
        correta: 1,
        explicacao: "Prompt é uma instrução ou solicitação enviada a uma ferramenta de IA."
    },

    {
        pergunta: "A IA pode ajudar na educação?",
        opcoes: [
            "Não",
            "Somente em matemática",
            "Sim, auxiliando no aprendizado",
            "Somente em escolas particulares"
        ],
        correta: 2,
        explicacao: "A IA pode auxiliar estudantes e professores em diversas atividades."
    },

    {
        pergunta: "O que é programação?",
        opcoes: [
            "Criar instruções para computadores",
            "Apenas utilizar redes sociais",
            "Montar móveis",
            "Editar fotografias"
        ],
        correta: 0,
        explicacao: "Programação é o processo de criar instruções que computadores executam."
    },

    {
        pergunta: "Qual é uma atitude importante ao utilizar IA?",
        opcoes: [
            "Acreditar em tudo automaticamente",
            "Compartilhar todas as senhas",
            "Verificar informações e usar com responsabilidade",
            "Ignorar a privacidade"
        ],
        correta: 2,
        explicacao: "É importante verificar informações e proteger os dados pessoais."
    }

];

let atual = 0;
let pontuacao = 0;
let respondeu = false;

function carregar() {

    respondeu = false;

    const p = perguntas[atual];

    document.getElementById("questionNumber").textContent =
        "Questão " + (atual + 1) + " de " + perguntas.length;

    document.getElementById("points").textContent =
        "Pontos: " + pontuacao;

    document.getElementById("progress").style.width =
        (atual / perguntas.length * 100) + "%";

    document.getElementById("question").textContent = p.pergunta;

    document.getElementById("feedback").textContent = "";

    document.getElementById("nextButton").style.display = "none";

    const area = document.getElementById("answers");

    area.innerHTML = "";

    p.opcoes.forEach((opcao, indice) => {

        const botao = document.createElement("button");

        botao.className = "answer";
        botao.textContent = opcao;

        botao.onclick = () => responder(indice, botao);

        area.appendChild(botao);

    });

}

function responder(indice, botao) {

    if (respondeu) return;

    respondeu = true;

    const p = perguntas[atual];

    const botoes = document.querySelectorAll(".answer");

    botoes.forEach((b, i) => {

        b.disabled = true;

        if (i === p.correta) {
            b.classList.add("correct");
        }

    });

    if (indice === p.correta) {

        pontuacao++;

        document.getElementById("feedback").style.color = "#39d98a";

        document.getElementById("feedback").textContent =
            "Resposta correta! " + p.explicacao;

    } else {

        botao.classList.add("wrong");

        document.getElementById("feedback").style.color = "#ff8792";

        document.getElementById("feedback").textContent =
            "Resposta incorreta. " + p.explicacao;

    }

    document.getElementById("points").textContent =
        "Pontos: " + pontuacao;

    document.getElementById("nextButton").style.display = "block";

    document.getElementById("nextButton").textContent =
        atual === perguntas.length - 1
        ? "Ver resultado"
        : "Próxima questão";

}

function proxima() {

    atual++;

    if (atual < perguntas.length) {

        carregar();

    } else {

        finalizar();

    }

}

function finalizar() {

    document.getElementById("quizContent").style.display = "none";

    document.getElementById("result").style.display = "block";

    document.getElementById("progress").style.width = "100%";

    document.getElementById("score").textContent =
        pontuacao + "/" + perguntas.length;

    let mensagem = "";

    if (pontuacao === 12) {
        mensagem = "Excelente! Você dominou o desafio!";
    } else if (pontuacao >= 9) {
        mensagem = "Muito bom! Você tem ótimos conhecimentos!";
    } else if (pontuacao >= 6) {
        mensagem = "Bom trabalho! Continue aprendendo!";
    } else {
        mensagem = "Continue estudando. Cada desafio é uma oportunidade de aprender!";
    }

    document.getElementById("resultMessage").textContent = mensagem;

}

function reiniciar() {

    atual = 0;
    pontuacao = 0;
    respondeu = false;

    document.getElementById("quizContent").style.display = "block";

    document.getElementById("result").style.display = "none";

    carregar();

}

function jogoLogica() {

    const resposta = prompt(
        "DESAFIO DE LÓGICA\n\nQual número completa a sequência?\n\n2, 4, 8, 16, ?"
    );

    if (resposta === null) return;

    if (resposta.trim() === "32") {
        alert("Correto! Você encontrou o padrão!");
    } else {
        alert("Resposta incorreta! A resposta era 32.");
    }

}

function jogoMatematica() {

    const resposta = prompt(
        "DESAFIO MATEMÁTICO\n\nQuanto é 15 x 8?"
    );

    if (resposta === null) return;

    if (resposta.trim() === "120") {
        alert("Parabéns! Resposta correta!");
    } else {
        alert("Não foi dessa vez! A resposta era 120.");
    }

}

function jogoTecnologia() {

    const resposta = prompt(
        "DESAFIO TECNOLÓGICO\n\nQual destes é um navegador de internet?\n\nA) Chrome\nB) Excel\nC) Photoshop\nD) Calculadora"
    );

    if (resposta === null) return;

    if (resposta.trim().toLowerCase() === "a" ||
        resposta.trim().toLowerCase() === "chrome") {

        alert("Correto! Chrome é um navegador de internet.");

    } else {

        alert("Resposta incorreta! A resposta era Chrome.");

    }

}

carregar();

</script>

</body>
</html>
